# Copy to .env.e2e and fill in real values (`.env.e2e` is gitignored):
#   cp .env.e2e.example .env.e2e
#
# Base URL of the desktop UI (trailing slash required for subdirectory installs):
PLAYWRIGHT_BASE_URL=http://localhost:8888/
# Staging example:
# PLAYWRIGHT_BASE_URL=https://aurora-mta.afterlogic.com/aurora-mta-dev/

# Multiply all T() timeouts (navigation, waits, test.setTimeout). Use 2 for slow
# remote staging; default 1 leaves local runs unchanged.
# E2E_TIMEOUT_SCALE=2

# Parallel Playwright workers (default 1 — keep 1 to avoid mailbox races).
# PLAYWRIGHT_WORKERS=1

# App variant: "desktop" (Knockout, form-submit login) or "next" (Vue SPA, API auth).
# Auto-detected when unset; set explicitly if detection fails.
# E2E_APP_VARIANT=next
E2E_APP_VARIANT=desktop

# --- Role accounts -----------------------------------------------------------
# PRIMARY — default login for almost all tests (mail/contacts/files mutations)
E2E_LOGIN_PRIMARY=your-primary@example.com
E2E_PASSWORD_PRIMARY=your-primary-password

# SECONDARY — multi-user flows (share with teammate, accept share, etc.)
E2E_LOGIN_SECONDARY=your-secondary@example.com
E2E_PASSWORD_SECONDARY=your-secondary-password

# RESERVE — permission / ACL scenarios (limited rights user)
E2E_LOGIN_RESERVE=your-reserve@example.com
E2E_PASSWORD_RESERVE=your-reserve-password

# Optional: force compose recipient for every send (default = PRIMARY login)
# E2E_COMPOSE_TO=someone@example.com
