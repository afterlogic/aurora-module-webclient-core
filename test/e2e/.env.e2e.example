# Copy to .env.e2e and fill in real values (`.env.e2e` is gitignored):
#   cp .env.e2e.example .env.e2e
#
# Default URL = local desktop UI:
PLAYWRIGHT_BASE_URL=http://localhost:8888/

# Account pool (one isolated mailbox per parallel worker).
# Default workers = 2 when 2+ accounts exist (cap = pool size).
# Override: PLAYWRIGHT_WORKERS=1|2|3|4
E2E_LOGIN_0=your-test-user-0@example.com
E2E_PASSWORD_0=your-test-password-0
E2E_LOGIN_1=your-test-user-1@example.com
E2E_PASSWORD_1=your-test-password-1
# E2E_LOGIN_2=your-test-user-2@example.com
# E2E_PASSWORD_2=your-test-password-2
# E2E_LOGIN_3=your-test-user-3@example.com
# E2E_PASSWORD_3=your-test-password-3

# Optional single-account fallback (used only when no E2E_LOGIN_N is set):
# E2E_LOGIN=your-test-user@example.com
# E2E_PASSWORD=your-test-password

# Optional: force the same compose recipient for every worker (default = worker login)
# E2E_COMPOSE_TO=your-test-user@example.com
