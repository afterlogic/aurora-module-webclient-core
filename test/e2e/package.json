{
  "name": "aurora-corewebclient-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Playwright runner for Aurora desktop E2E (specs in modules/*/test/e2e)",
  "scripts": {
    "test:e2e": "NODE_PATH=./node_modules playwright test",
    "test:e2e_local": "NODE_PATH=./node_modules playwright test",
    "test:e2e:ui": "NODE_PATH=./node_modules playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install-browsers": "playwright install chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.21.1"
  }
}
